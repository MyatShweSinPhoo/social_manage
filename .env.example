# =====================================================================
#  SOCIAL HUB  -  Facebook Page + TikTok scheduler (one project)
# =====================================================================

# ---------- Database (MySQL / XAMPP) ----------
# Both Facebook and TikTok tables live in this one database.
DATABASE_URL="mysql://root:@localhost:3306/social_hub"

# ---------- Admin login (shared by Facebook + TikTok panels) ----------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"
# Random secret (32+ chars) used to sign the login cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ---------- Public URL of this app ----------
# TikTok photo posts pull images from here (must be a URL prefix verified in the TikTok developer portal).
PUBLIC_BASE_URL="https://your-domain.com"
# Base folder for uploads. Facebook images go to <UPLOAD_DIR>/facebook, TikTok media to <UPLOAD_DIR>/tiktok
UPLOAD_DIR="./uploads"

# =====================================================================
#  FACEBOOK
# =====================================================================
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_GRAPH_VERSION="v27.0"

# =====================================================================
#  TIKTOK
# =====================================================================
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# inbox  = send the video to the creator's TikTok drafts (works before app audit, needs a manual tap in TikTok)
# direct = publish straight to the profile (needs TikTok audit for public posts)
TIKTOK_MODE="inbox"
# Until your app passes TikTok's audit only SELF_ONLY is accepted
TIKTOK_PRIVACY="SELF_ONLY"
# Daily TikTok posting slots (local time) used when you don't pick a time, and your timezone
POST_TIMES="09:00,13:00,19:00"
TZ_OFFSET_MIN="390"
TZ_NAME="Asia/Yangon"

# ---------- Telegram bot (TikTok control, optional) ----------
TELEGRAM_BOT_TOKEN=""
# comma-separated Telegram user IDs allowed to control the bot (send /start to the bot to see yours)
TELEGRAM_ADMIN_IDS=""

# ---------- AI idea + caption generation (optional) ----------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
CONTENT_LANGUAGE="Burmese"

# =====================================================================
#  SCHEDULERS
# =====================================================================
# "true"  -> the Next.js server itself publishes due Facebook + TikTok posts (needs an always-on server)
# "false" -> turn it off and call /api/cron/publish from an external cron instead
ENABLE_INTERNAL_SCHEDULER="true"
# "false" -> don't start the Telegram bot inside the web server (use `npm run services` instead)
ENABLE_TELEGRAM_BOT="true"
# Secret for /api/cron/publish (send as "Authorization: Bearer <secret>")
CRON_SECRET=""

# ---------- Optional ----------
# Set to "false" if you test a production build (npm start) over plain http://localhost
# COOKIE_SECURE="false"
